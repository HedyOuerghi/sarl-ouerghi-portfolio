---
import { getStore } from "@netlify/blobs";
import AdminNav from "../../components/AdminNav.astro";
import { isAdminAuthenticated } from "../../lib/adminAuth";
import "../../styles/global.css";

export const prerender = false;

if (!(await isAdminAuthenticated(Astro.session))) {
  return Astro.redirect(`/oauth?next=${encodeURIComponent(Astro.url.pathname)}`);
}

const store = getStore({ name: "factures", consistency: "strong" });
const entries: any[] = (await store.get("entries", { type: "json" })) ?? [];
entries.sort((a, b) => (a.date < b.date ? 1 : -1));

const totalImpaye = entries
  .filter((f) => f.statut === "impayee")
  .reduce((sum, f) => sum + (Number(f.montant) || 0), 0);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Factures | Admin SARL Ouerghi</title>
  </head>
  <body class="min-h-screen bg-surface text-slate">
    <AdminNav current="factures" />
    <main class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
      <h1 class="font-heading text-3xl font-semibold text-petrol">Factures</h1>
      <p class="mt-2 text-sm text-slate-soft">
        Total impayé : <span class="font-semibold text-copper">{totalImpaye.toFixed(2)} €</span>
      </p>

      <form
        method="POST"
        action="/admin/factures-add"
        class="mt-6 flex flex-col gap-3 rounded-2xl border border-border bg-white p-5"
      >
        <p class="font-heading font-semibold text-petrol">Ajouter une facture</p>
        <div class="grid gap-3 sm:grid-cols-2">
          <label class="flex flex-col gap-1 text-sm">
            Client
            <input
              type="text"
              name="client"
              required
              class="rounded-lg border border-border px-3 py-2 focus-visible:border-copper"
            />
          </label>
          <label class="flex flex-col gap-1 text-sm">
            Montant (€)
            <input
              type="number"
              step="0.01"
              name="montant"
              required
              class="rounded-lg border border-border px-3 py-2 focus-visible:border-copper"
            />
          </label>
          <label class="flex flex-col gap-1 text-sm">
            Date
            <input
              type="date"
              name="date"
              required
              class="rounded-lg border border-border px-3 py-2 focus-visible:border-copper"
            />
          </label>
          <label class="flex flex-col gap-1 text-sm">
            Statut
            <select name="statut" class="rounded-lg border border-border px-3 py-2 focus-visible:border-copper">
              <option value="impayee">Impayée</option>
              <option value="payee">Payée</option>
            </select>
          </label>
        </div>
        <label class="flex flex-col gap-1 text-sm">
          Notes
          <textarea name="notes" rows="2" class="rounded-lg border border-border px-3 py-2 focus-visible:border-copper"
          ></textarea>
        </label>
        <button
          type="submit"
          class="shadow-soft-hover mt-1 self-start rounded-full bg-copper px-6 py-2 font-heading text-sm font-semibold text-white transition-colors hover:bg-copper-hover"
        >
          Ajouter
        </button>
      </form>

      <div class="mt-8 overflow-x-auto rounded-2xl border border-border bg-white">
        <table class="w-full border-collapse text-sm">
          <thead>
            <tr class="border-b border-border text-left">
              <th class="p-3 font-heading text-petrol">Date</th>
              <th class="p-3 font-heading text-petrol">Client</th>
              <th class="p-3 font-heading text-petrol">Montant</th>
              <th class="p-3 font-heading text-petrol">Statut</th>
              <th class="p-3 font-heading text-petrol">Notes</th>
              <th class="p-3"></th>
            </tr>
          </thead>
          <tbody>
            {
              entries.map((f) => (
                <tr class="border-b border-border last:border-0">
                  <td class="whitespace-nowrap p-3">{f.date}</td>
                  <td class="p-3 font-semibold text-petrol">{f.client}</td>
                  <td class="whitespace-nowrap p-3">{Number(f.montant).toFixed(2)} €</td>
                  <td class="p-3">
                    <form method="POST" action="/admin/factures-toggle" class="inline">
                      <input type="hidden" name="id" value={f.id} />
                      <button
                        type="submit"
                        class:list={[
                          "rounded-full px-2.5 py-1 text-xs font-semibold",
                          f.statut === "payee" ? "bg-green-100 text-green-700" : "bg-red-100 text-red-700",
                        ]}
                      >
                        {f.statut === "payee" ? "Payée" : "Impayée"}
                      </button>
                    </form>
                  </td>
                  <td class="p-3 text-slate-soft">{f.notes}</td>
                  <td class="p-3">
                    <form method="POST" action="/admin/factures-delete">
                      <input type="hidden" name="id" value={f.id} />
                      <button type="submit" class="text-xs text-slate-soft underline hover:text-copper">
                        Supprimer
                      </button>
                    </form>
                  </td>
                </tr>
              ))
            }
            {
              entries.length === 0 && (
                <tr>
                  <td colspan="6" class="p-3 text-slate-soft">
                    Aucune facture pour l'instant.
                  </td>
                </tr>
              )
            }
          </tbody>
        </table>
      </div>
    </main>
  </body>
</html>
